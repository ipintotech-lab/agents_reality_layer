REALITY_DATABASE_URL=postgresql+psycopg://reality:reality@localhost:5432/reality
REALITY_OBJECT_STORAGE_ROOT=./data/raw_payloads
REALITY_ENVIRONMENT=local
REALITY_LOG_LEVEL=INFO
REALITY_PERSISTENCE_ENABLED=false
REALITY_SHOPIFY_DOMAIN=
REALITY_SHOPIFY_ACCESS_TOKEN=
REALITY_EASYPOST_API_KEY=

# Governance (start a fresh workspace in observe_only; operator enables demo_proposal)
REALITY_WORKSPACE_MODE=demo_proposal
# REALITY_WRITE_VALUE_LIMIT=500.0

# Verifier worker: bounded read-after-write polling
REALITY_VERIFIER_INITIAL_INTERVAL_SECONDS=2.0
REALITY_VERIFIER_BACKOFF_FACTOR=2.0
REALITY_VERIFIER_MAX_INTERVAL_SECONDS=10.0
REALITY_VERIFIER_MAX_ATTEMPTS=6
REALITY_VERIFIER_TIMEOUT_SECONDS=30.0
REALITY_VERIFIER_SWEEP_INTERVAL_SECONDS=5.0
